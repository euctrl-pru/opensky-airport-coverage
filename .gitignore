.venv/
__pycache__/
*.pyc
.env
site/_site/
site/.quarto/
site/airports/*.qmd
!site/airports/index.qmd
data/pages/
site/airports/figures/

# Quarto's per-page render output. It lands beside the generated pages and is
# rebuilt on every render, so committing it adds hundreds of files per build
# and nothing that CI cannot reproduce.
site/airports/*_files/
site/site_libs/
site/*_files/
site/airports/*.html
# ...and the same output for the top-level pages, which a single-file
# `quarto render index.qmd` drops beside the source rather than in
# `_site/`. Only the `airports/` copies were ignored, so these four sat
# untracked at the root of `site/` waiting to be committed by accident.
site/*.html
